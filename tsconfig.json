{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Sources of the buckyos repository that the client shares (README, "Shared sources"): a sibling checkout, or
       .buckyos in CI. They import the WebSDK; it is this project's copy for them too. */
    "paths": {
      "@buckyos-desktop/*": [
        "../buckyos/src/frame/desktop/src/shared/*",
        "./.buckyos/src/frame/desktop/src/shared/*"
      ],
      "buckyos": ["./node_modules/buckyos"],
      "buckyos/*": ["./node_modules/buckyos/dist/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
