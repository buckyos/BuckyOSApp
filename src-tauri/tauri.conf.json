{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "BuckyOS",
    "version": "1.0.0",
    "identifier": "com.buckyos.buckyosapp",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "BuckyOS",
                "width": 400,
                "height": 800,
                "resizable": true,
                "maximizable": false,
                "label": "main",
                "minHeight": 560,
                "minWidth": 400,
                "maxWidth": 400,
                "backgroundThrottling": "disabled"
            }
        ],
        "security": {
            "csp": "default-src 'self'; frame-src *; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-eval'; connect-src 'self' http: https: wss:; media-src 'self' blob: zonemedia: http://zonemedia.localhost;"
        }
    },
    "bundle": {
        "license": "AGPL-3.0-only",
        "licenseFile": "../LICENSE",
        "resources": {
            "../LICENSE": "licenses/LICENSE",
            "../NOTICE": "licenses/NOTICE"
        },
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "iOS": {
            "minimumSystemVersion": "17.0"
        }
    },
    "plugins": {
        "deep-link": {
            "mobile": [
                {
                    "scheme": [
                        "buckyos"
                    ],
                    "appLink": false
                }
            ],
            "desktop": {
                "schemes": [
                    "buckyos"
                ]
            }
        }
    }
}
