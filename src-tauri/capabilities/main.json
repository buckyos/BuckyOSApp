{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The local pages of the main window: every command of the client. No remote page has this.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-title",
    "opener:default",
    "store:default",
    "log:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://*"
        },
        {
          "url": "https://*"
        },
        {
          "url": "http://*:*"
        },
        {
          "url": "https://*:*"
        }
      ]
    },
    "allow-generate-mnemonic",
    "allow-validate-mnemonic-words",
    "allow-derive-registration-material",
    "allow-create-did",
    "allow-import-did",
    "allow-update-owner-document",
    "allow-wallet-exists",
    "allow-list-dids",
    "allow-active-did",
    "allow-set-active-did",
    "allow-delete-wallet",
    "allow-reveal-mnemonic",
    "allow-extend-wallets",
    "allow-current-wallet-nickname",
    "allow-generate-zone-boot-config-jwt",
    "allow-list-sn-statuses",
    "allow-set-sn-status",
    "allow-clear-sn-status",
    "allow-sign-json-with-active-did",
    "allow-local-ipv4-list",
    "allow-scan-device-batch",
    "allow-resolve-did",
    "allow-get-service-endpoints",
    "allow-zone-list",
    "allow-zone-probe",
    "allow-zone-sync-owner",
    "allow-zone-add",
    "allow-zone-login",
    "allow-zone-reconnect",
    "allow-zone-logout",
    "allow-zone-remove",
    "allow-zone-set-current",
    "allow-zone-update",
    "allow-zone-rpc",
    "allow-zone-fetch",
    "allow-zone-image",
    "allow-zone-lines",
    "allow-zone-find",
    "allow-route-status",
    "allow-route-set-browser",
    "allow-content-open",
    "allow-content-focus",
    "allow-content-close",
    "allow-content-closing",
    "allow-activation-open",
    "allow-activation-close",
    "allow-content-list",
    "allow-content-emit",
    "allow-content-set-title",
    "allow-content-set-icon",
    "allow-content-layout",
    "allow-content-overlay",
    "allow-content-back",
    "allow-deeplink-ready",
    "allow-notify-status",
    "allow-notify-recent",
    "allow-notify-set-labels",
    "allow-notify-settings",
    "allow-notify-set-enabled",
    "allow-notify-permission",
    "allow-notify-refresh",
    "allow-notify-activate",
    "allow-notify-show",
    "allow-quit-started",
    "allow-quit-confirmed",
    "allow-tray-set-enabled",
    "allow-tray-set-labels",
    "allow-tray-get-state",
    "allow-tray-start-service",
    "allow-tray-stop-service",
    "allow-tray-restart-service",
    "allow-tray-refresh-status",
    "allow-tray-finish-setup",
    "allow-tray-request-permissions",
    "allow-tray-set-autostart"
  ]
}
